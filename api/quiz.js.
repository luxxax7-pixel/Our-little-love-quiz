// Vercel serverless API for Our Little Love Quiz.
// Secrets belong in Vercel Environment Variables, never in browser code or GitHub.
const SUPABASE_URL = process.env.SUPABASE_URL;
const SUPABASE_SERVICE_ROLE_KEY = process.env.SUPABASE_SERVICE_ROLE_KEY;
const headers = { 'Content-Type': 'application/json', 'Cache-Control': 'no-store' };
function send(res, status, data) { return res.status(status).setHeader('Cache-Control','no-store').json(data); }
function code() { return Array.from(crypto.getRandomValues(new Uint8Array(9)), x => x.toString(36).padStart(2,'0')).join('').slice(0,15); }
async function db(path, method='GET', body) {
  if (!SUPABASE_URL || !SUPABASE_SERVICE_ROLE_KEY) throw new Error('Server configuration is missing.');
  const r = await fetch(`${SUPABASE_URL}/rest/v1/${path}`, { method, headers: { apikey: SUPABASE_SERVICE_ROLE_KEY, Authorization: `Bearer ${SUPABASE_SERVICE_ROLE_KEY}`, 'Content-Type':'application/json', Prefer: method==='POST' ? 'return=representation' : 'return=representation' }, ...(body === undefined ? {} : { body: JSON.stringify(body) }) });
  const t = await r.text();
  if (!r.ok) throw new Error(`Database request failed (${r.status}).`);
  return t ? JSON.parse(t) : null;
}
module.exports = async (req, res) => {
  try {
    if (req.method === 'OPTIONS') return res.status(204).setHeader('Allow','GET,POST,OPTIONS').end();
    const action = req.method === 'GET' ? 'get' : req.body?.action;
    if (action === 'create' && req.method === 'POST') {
      const { creator_name, questions, answer_key, custom_answer } = req.body || {};
      if (typeof creator_name !== 'string' || !creator_name.trim() || creator_name.length > 40) return send(res,400,{error:'Enter a creator name up to 40 characters.'});
      if (!Array.isArray(questions) || questions.length !== 10 || !Array.isArray(answer_key) || answer_key.length !== 10 || !answer_key.every(x=>Number.isInteger(x)&&x>=0&&x<=3)) return send(res,400,{error:'Invalid quiz data.'});
      let share_code;
      for(let i=0;i<4;i++){ share_code=code(); const found=await db(`quizzes?share_code=eq.${share_code}&select=id`); if(!found.length) break; }
      const rows = await db('quizzes','POST',{creator_name:creator_name.trim(),share_code,questions,answer_key,custom_answer:typeof custom_answer==='string'?custom_answer.slice(0,160):''});
      return send(res,201,{share_code:rows[0].share_code});
    }
    if (action === 'get' && req.method === 'GET') {
      const share_code = String(req.query.code||'').replace(/[^a-zA-Z0-9]/g,'').slice(0,20);
      if(!share_code) return send(res,400,{error:'Missing quiz code.'});
      const rows = await db(`quizzes?share_code=eq.${share_code}&select=id,creator_name,share_code,questions,created_at`);
      if(!rows.length) return send(res,404,{error:'Quiz not found.'});
      // Intentionally never return answer_key from this public endpoint.
      return send(res,200,rows[0]);
    }
    if (action === 'submit' && req.method === 'POST') {
      const { share_code, respondent_name, answers, notes } = req.body || {};
      if(typeof share_code!=='string' || typeof respondent_name!=='string' || !respondent_name.trim() || respondent_name.length>40 || !Array.isArray(answers) || answers.length!==10 || !answers.every(x=>Number.isInteger(x)&&x>=0&&x<=3) || !Array.isArray(notes) || notes.length!==10 || !notes.every(x=>typeof x==='string'&&x.length<=240)) return send(res,400,{error:'Invalid response data.'});
      const qs=await db(`quizzes?share_code=eq.${encodeURIComponent(share_code)}&select=id,answer_key,questions,custom_answer`);
      if(!qs.length) return send(res,404,{error:'Quiz not found.'});
      const q=qs[0], score=answers.reduce((n,a,i)=>n+(a===q.answer_key[i]?1:0),0);
      const rows=await db('quiz_responses','POST',{quiz_id:q.id,respondent_name:respondent_name.trim(),answers,notes,score});
      // Reveal answer key only after submission; response is stored before returning it.
      return send(res,201,{response_id:rows[0].id,score,answer_key:q.answer_key,custom_answer:q.custom_answer||'',questions:q.questions});
    }
    return send(res,405,{error:'Unsupported action.'});
  } catch(e) { console.error(e); return send(res,500,{error:'The quiz service had a problem. Check the server setup and database schema.'}); }
};
